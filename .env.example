
# API Configuration
EXPO_PUBLIC_API_URL=https://api-dev.company.com/v1
EXPO_PUBLIC_ANALYTICS_KEY=your-analytics-key

# App Configuration  
EXPO_PUBLIC_APP_NAME=Enterprise Expo App
